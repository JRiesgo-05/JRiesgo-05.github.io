---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { lab, type Status } from '../data/lab';

const board: Status[] = ['Driving', 'Testing', 'Moved on'];

const recent = (await getCollection('log', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const principles = [
	{
		title: 'Learn through what you know',
		body: "I don't ask an agent to explain something from scratch. I tell it what I already know and ask it to build from there. Then I cut the answer down. If it's longer than a few sentences, I don't understand it yet.",
		prompt:
			"Explain Astro's content collections in terms of Django models and templates, as a one-page HTML artifact. Keep the text under five sentences, and show where the comparison breaks.",
		result: { href: '/examples/astro-vs-django/', label: 'See what this prompt made' },
	},
	{
		title: 'Thin prompts, thick artifacts',
		mantra: 'Thin prompts + thick artifacts and context + thin skills.',
		body: "My prompts are short. What I hand the agent is thick: the files, the history, the examples. What I ask back is thick too: an HTML page or a diagram instead of a wall of text. My skills stay thin, a few lines each. I learned this from Thariq Shihipar's writing and was teaching it in our September workshop. Andrej Karpathy made the same case in October: ask for diagrams and web pages, not paragraphs.",
		refs: [
			{ href: 'https://x.com/trq212/status/2052809885763747935', label: 'Thariq: The Unreasonable Effectiveness of HTML' },
			{ href: 'https://x.com/karpathy/status/2105819303471976479', label: 'Karpathy on understanding LLM outputs' },
		],
	},
	{
		title: 'Principles over band-aids',
		body: "A patch fixes today's bug. A principle fixes the next ten. When something breaks, I don't stop at the fix. I keep asking until I find the rule underneath, and that rule is what I write down.",
		prompt:
			"This test fails about one run in ten. Don't fix it yet. List what has to be true for it to pass every time, and tell me which of those isn't.",
	},
	{
		title: 'Change the angle',
		body: "Code is one layer over the real job, which is turning inputs into outcomes. Googling and asking an agent are the same act: moving information into my head. The agent just moves it faster, so I spend the saved time one level up.",
		prompt:
			'Before writing any code, describe the inputs this feature gets and the output it must produce. Then tell me whether code is the right layer to solve it.',
	},
];

const workshops = [
	{
		date: 'Oct 16, 2026',
		title: 'Agent Building Workshop',
		href: '/workshops/agent-building/',
		audience: 'Internal, about 30 colleagues from the COO to QA. Slides only, speaker notes removed.',
		body: 'The follow-up for people who wanted to build. We built one ticket-triage agent end to end: tools, MCP, LLM as a judge and model routing on day one, then how to test it before it ships on day two.',
	},
	{
		date: 'Sep 15–16, 2026',
		title: 'AI Fluency & Claude Code Workshop',
		href: '/workshops/ai-fluency/',
		audience: 'Internal, about 30 colleagues from the COO to QA. Slides only, speaker notes removed.',
		body: 'Two days for everyone, not just engineers. We started with how a model reads (tokens, embeddings, the context window) and ended with the way I actually work in Claude Code every day.',
	},
	{
		date: 'Jun 2025',
		title: 'LLMs and Generative AI, guest workshop at T.I.P.',
		href: 'https://www.linkedin.com/posts/jerimiah-riesgo-598070190_genai-guestspeaker-al-activity-7343175397066362880-XBio',
		audience: 'Computer Engineering students, Technological Institute of the Philippines.',
		body: 'My alma mater invited me back to walk students through how large language models work and where they help in practice.',
	},
];

const work = [
	{
		years: '2025 – 2026',
		org: 'WPP Media',
		role: 'Senior Python Developer',
		body: 'Coordinate the AI product team from integration to production, run R&D on agentic design and systems, and test new models such as Jev.',
	},
	{
		years: '2022 – 2025',
		org: 'Accenture',
		role: 'Senior Data Engineer to Associate Manager',
		body: 'Cut data pipelines from hours to minutes, built GenAI features and dashboards, and worked as sub-architect and sub-Scrum Master.',
	},
	{
		years: '2021 – 2022',
		org: 'BizKit Technologies',
		role: 'Python Developer',
		body: 'Moved small and mid-sized businesses from manual processes onto an open-source ERP.',
	},
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<header style="display: flex; flex-direction: column; gap: 20px;">
		<h1 class="serif" style="margin: 0; font-size: clamp(44px, 9vw, 64px); line-height: 1.05;">
			Jerimiah Riesgo
		</h1>
		<p style="margin: 0; font-size: 20px;">
			I learn in public with AI as my study partner.
			<em class="serif" style="font-size: 24px; color: var(--accent);">This is the log.</em>
		</p>
		<p class="muted" style="margin: 0;">
			I'm a senior Python developer at WPP Media. Most of my day is agents: getting our AI product
			team's work from integration to production, R&amp;D on agentic systems, and testing new models
			as they land.
		</p>
		<p style="margin: 0;">
			I built this site to show my journey with AI, from my first GPT-2 experiment to how I work today.
			When I talk about my workflow, I want something real to point at: the skills, repos and workflows
			I've tried, what stuck, and what didn't.
		</p>
		<p class="muted" style="margin: 0;">
			It's also how I keep what I learn. An answer that took ten seconds to get takes ten seconds to
			lose, so I write down what stuck: what I learned, the principle behind it, and the angle that
			made it click.
		</p>
		<p class="faint" style="margin: 0;">Based in Cavite, Philippines.</p>
	</header>

	<section id="principles" style="display: flex; flex-direction: column; gap: 32px;">
		<h2 class="label">What I believe about learning</h2>
		{
			principles.map((p) => (
				<div style="display: flex; flex-direction: column; gap: 6px;">
					<h3 class="serif" style="margin: 0; font-size: 28px; line-height: 1.2;">
						{p.title}
					</h3>
					{p.mantra && (
						<p class="serif" style="margin: 0; font-size: 22px; font-style: italic; color: var(--accent);">
							{p.mantra}
						</p>
					)}
					<p class="muted" style="margin: 0;">
						{p.body}
					</p>
					{p.prompt && (
						<div class="prompt">
							<span class="label">Example prompt</span>
							<p>{p.prompt}</p>
							{p.result && <a href={p.result.href}>{p.result.label} →</a>}
						</div>
					)}
					{p.refs && (
						<p class="faint" style="margin: 0; display: flex; flex-wrap: wrap; gap: 4px 16px;">
							{p.refs.map((r) => (
								<a href={r.href}>{r.label}</a>
							))}
						</p>
					)}
				</div>
			))
		}
	</section>

	<section id="lab" style="display: flex; flex-direction: column; gap: 16px;">
		<h2 class="label">From the Lab</h2>
		<p class="muted" style="margin: 0; font-size: 16px;">
			The workflows and tools I'm driving, testing and have moved on from.
		</p>
		{
			board.map((status) => (
				<div class="entry" style="justify-content: flex-start;">
					<span class="chip" style="min-width: 92px; text-align: center;">{status}</span>
					<span>{lab.filter((i) => i.status === status).map((i) => i.name).join(' · ')}</span>
				</div>
			))
		}
		<a href="/lab/" class="faint">Open the Lab →</a>
	</section>

	<section id="log" style="display: flex; flex-direction: column; gap: 16px;">
		<h2 class="label">Recent notes</h2>
		{
			recent.map((post) => (
				<a class="entry" href={`/log/${post.id}/`}>
					<span>{post.data.title}</span>
					<span class="faint">
						<FormattedDate date={post.data.pubDate} />
					</span>
				</a>
			))
		}
		<a href="/log/" class="faint">All notes →</a>
	</section>

	<section id="workshops" style="display: flex; flex-direction: column; gap: 28px;">
		<h2 class="label">Workshops I've run</h2>
		{
			workshops.map((w) => (
				<div style="display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 4px 24px;">
					<span class="faint" style="font-variant-numeric: tabular-nums;">
						{w.date}
					</span>
					<div style="display: flex; flex-direction: column; gap: 4px; min-width: 0;">
						<h3 class="serif" style="margin: 0; font-size: 24px; line-height: 1.2;">
							<a href={w.href}>{w.title}</a>
						</h3>
						<p class="muted" style="margin: 0; font-size: 16px;">
							{w.body}
						</p>
						<p class="faint" style="margin: 0;">
							{w.audience}
						</p>
					</div>
				</div>
			))
		}
	</section>

	<section id="work" style="display: flex; flex-direction: column; gap: 28px;">
		<h2 class="label">Where I've worked</h2>
		{
			work.map((w) => (
				<div style="display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 4px 24px;">
					<span class="faint" style="font-variant-numeric: tabular-nums;">
						{w.years}
					</span>
					<div style="display: flex; flex-direction: column; gap: 4px; min-width: 0;">
						<h3 class="serif" style="margin: 0; font-size: 24px; line-height: 1.2;">
							{w.org} <span class="faint" style="font-family: var(--font-sans);">· {w.role}</span>
						</h3>
						<p class="muted" style="margin: 0; font-size: 16px;">
							{w.body}
						</p>
					</div>
				</div>
			))
		}
		<p class="faint" style="margin: 0; border-top: 1px solid var(--rule); padding-top: 20px;">
			Along the way: 4th place, Accenture Global Agentic Hackathon 2025 · Gantimpala Award, Q3 LIKHA (2025) · AWS Certified Developer –
			Associate · MS Data Science and BS Computer Engineering, Technological Institute of the
			Philippines.
		</p>
	</section>
</Base>

<style>
	@media (max-width: 480px) {
		#work > div,
		#workshops > div {
			grid-template-columns: minmax(0, 1fr) !important;
		}
	}
</style>
